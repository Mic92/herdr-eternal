                 }
diff --git a/src/client/mod.rs b/src/client/mod.rs
index f55db195..e6efe44d 100644
--- a/src/client/mod.rs
+++ b/src/client/mod.rs
@@ -79,6 +79,28 @@ use terminal_setup::{
     setup_direct_attach_terminal, setup_terminal, should_draw_host_cursor, TerminalGuard,
 };
 
+/// Only toggles between Online and Stalled; lifecycle states owned by the supervisor win.
+fn set_endpoint_link_status(
+    state: &mut ClientState,
+    endpoint_id: &endpoint::ClientEndpointId,
+    status: endpoint::ClientEndpointStatus,
+) {
+    let (cols, rows) = state.reported_size;
+    let Some(shell) = state.shell.as_mut() else {
+        return;
+    };
+    if !matches!(
+        shell.endpoint_status(endpoint_id),
+        Some(endpoint::ClientEndpointStatus::Online | endpoint::ClientEndpointStatus::Stalled)
+    ) {
+        return;
+    }
+    shell.set_endpoint_status(endpoint_id, status);
+    if let Some(frame) = shell.compose(cols, rows) {
+        state.present_frame(frame);
+    }
+}
+
 fn refresh_host_mouse_capture(enabled: bool, sgr_pixels: bool) {
     if let Err(err) = set_mouse_capture(enabled, sgr_pixels) {
         warn!(err = %err, "failed to re-assert host mouse capture");
@@ -1432,7 +1454,13 @@ async fn run_client_loop(
                 if !write_stream.accepts(&endpoint_id, generation) {
                     continue;
                 }
-                write_stream.received(&endpoint_id, generation, now);
+                if write_stream.received(&endpoint_id, generation, now) {
+                    set_endpoint_link_status(
+                        &mut state,
+                        &endpoint_id,
+                        endpoint::ClientEndpointStatus::Online,
+                    );
+                }
                 // Retirements belong to the exact live connection, even after deactivation.
                 // They must not be dropped with frozen/inactive presentation effects.
                 if matches!(
@@ -2239,7 +2267,14 @@ async fn run_client_loop(
                 state
                     .detached_process_children
                     .retain_mut(|child| child.try_wait().ok().flatten().is_none());
-                write_stream.tick_health(now);
+                for endpoint_id in write_stream.tick_health(now) {
+                    warn!(endpoint = %endpoint_id.storage_key(), "endpoint link stalled");
+                    set_endpoint_link_status(
+                        &mut state,
+                        &endpoint_id,
+                        endpoint::ClientEndpointStatus::Stalled,
+                    );
+                }
                 for failure in write_stream.take_failures() {
                     if write_stream.connection(&failure.endpoint_id).is_some()
                         && !write_stream.accepts(&failure.endpoint_id, failure.generation)
